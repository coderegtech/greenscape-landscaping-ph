{
  "include": [
    "apps/**",
    "packages/**",
    "docker/**",
    "docs/deployment.md",
    "docs/deployment/**",
    "scripts/build.mjs",
    "scripts/create-admin.ts",
    "scripts/sweep-orphans.ts",
    "package.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    ".dockerignore",
    ".gitattributes",
    ".gitignore",
    ".nvmrc",
    ".env.example"
  ],
  "exclude": [
    "docker/compose.dev.yml",
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/coverage/**",
