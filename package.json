{
  "name": "greenscape",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter ./apps/* dev",
    "build": "node scripts/build.mjs",
    "typecheck": "pnpm -r --parallel typecheck && tsc -p tests",
    "services:up": "docker compose -f docker/compose.dev.yml up -d --wait",
    "services:down": "docker compose -f docker/compose.dev.yml down",
    "db:migrate": "pnpm --filter @greenscape/database migrate:dev",
    "db:deploy": "pnpm --filter @greenscape/database migrate:deploy",
    "db:seed": "pnpm --filter @greenscape/database seed",
    "content:indexes": "pnpm --filter @greenscape/content indexes",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start -x studio,imgproxy,vector,logflare,supavisor,postgres-meta,realtime,edge-runtime",
    "supabase:env": "node scripts/supabase-env.mjs",
    "lint": "eslint .",
    "content:seed": "tsx scripts/migrate/seed-content.ts",
    "shop:seed": "tsx scripts/migrate/seed-shop.ts",
    "media:migrate": "tsx scripts/migrate/media-to-supabase.ts",
    "assets:check": "tsx scripts/migrate/check-assets.ts",
    "data:import": "tsx scripts/migrate/import-export.ts",
    "storage:setup": "pnpm --filter @greenscape/storage buckets",
    "media:sweep": "tsx scripts/sweep-orphans.ts",
    "load:test": "tsx scripts/load-test.ts",
    "admin:create": "tsx scripts/create-admin.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@greenscape/auth": "workspace:*",
    "@greenscape/cache": "workspace:*",
    "@greenscape/config": "workspace:*",
    "@greenscape/content": "workspace:*",
    "@greenscape/database": "workspace:*",
    "@greenscape/storage": "workspace:*",
    "@greenscape/ui": "workspace:*",
    "@greenscape/validation": "workspace:*",
    "@next/eslint-plugin-next": "^16.4.5",
    "@playwright/test": "^1.65.0",
    "@supabase/supabase-js": "^2.119.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jose": "^6.2.16",
    "sharp": "0.35.5",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "overrides": {
      "uuid@<11.1.1": "^11.1.1"
    }
  }
}
