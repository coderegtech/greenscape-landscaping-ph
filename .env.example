# Copy to .env (root). Every app loads this file in development.
NODE_ENV=development

# Docker services (docker/compose.dev.yml) — host ports avoid the defaults
DATABASE_URL=postgresql://greenscape:greenscape@localhost:55433/greenscape?schema=public
MONGODB_URL=mongodb://localhost:57017/?replicaSet=rs0&directConnection=true
MONGODB_DB=greenscape
REDIS_URL=redis://localhost:56379
CACHE_PREFIX=gs:dev

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# Next.js apps
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=change-me-dev-only

# Supabase — local: `supabase start` then `pnpm supabase:env` fills these in
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shows the Google button only when the provider is configured in Supabase
NEXT_PUBLIC_AUTH_GOOGLE=false
# Local email inbox for verification/reset mails (tests read it)
MAILPIT_URL=http://127.0.0.1:54324

# Payments (Phase 8): mock | stripe_test
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Monitoring (optional in dev)
SENTRY_DSN=
