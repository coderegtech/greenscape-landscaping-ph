# Copy to .env (root). Every app loads this file in development.
NODE_ENV=development

# Docker services (docker/compose.dev.yml) — host ports avoid the defaults
DATABASE_URL=postgresql://greenscape:greenscape@localhost:55433/greenscape?schema=public
MONGODB_URL=mongodb://localhost:57017/?replicaSet=rs0&directConnection=true
MONGODB_DB=greenscape
REDIS_URL=redis://localhost:56379
CACHE_PREFIX=gs:dev

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
LOG_LEVEL=info

# Next.js apps
NEXT_PUBLIC_API_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
REVALIDATE_SECRET=change-me-dev-only-revalidate
# Lets the web app read drafts from the API for CMS preview (server-to-server only)
PREVIEW_SECRET=change-me-dev-only-preview
# Server-only, shared by api/web/admin: lets the Next servers pass the visitor's address to the API's rate limits.
# Generate per environment: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
INTERNAL_API_KEY=change-me-dev-only-internal-api-key-0123456789
# Proxies in front of the Next servers that append to X-Forwarded-For (1 = one CDN/load balancer).
TRUSTED_PROXY_HOPS=1

# Supabase — local: `supabase start` then `pnpm supabase:env` fills these in
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Shows the Google button only when the provider is configured in Supabase
NEXT_PUBLIC_AUTH_GOOGLE=false
# Local email inbox for verification/reset mails (tests read it)
MAILPIT_URL=http://127.0.0.1:54324

# Mail (local: Supabase Mailpit SMTP; inbox at MAILPIT_URL)
SMTP_URL=smtp://127.0.0.1:54325
MAIL_FROM=Greenscape Palawan <no-reply@greenscapelandscapingph.com>
# Who receives new quote / contact notifications (comma-separated)
QUOTE_NOTIFY_TO=greenscapepalawan@gmail.com

# Payments (Phase 8): mock | stripe_test. Test keys only (sk_test_…); live keys are refused.
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=change-me-dev-only-mockpay
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESERVATION_MINUTES=30
ORDER_NOTIFY_TO=greenscapepalawan@gmail.com

# Web Push (optional). `pnpm vapid:keys` prints a pair; the private key stays on the API server only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:greenscapepalawan@gmail.com

# Monitoring (optional in dev)
SENTRY_DSN=

# Shows the /design component gallery (never enable in production)
ENABLE_DESIGN_GALLERY=true
# Staff permissions require a multi-factor (authenticator app) session. Never false outside test suites.
REQUIRE_STAFF_MFA=true
# AI assistant (docs/auth/ai-assistant.md). Without a key the assistant uses the offline mock provider in development;
# an admin chooses the provider and model in Admin → AI assistant. Keys never leave the API.
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
