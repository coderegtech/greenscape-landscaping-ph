// Source of truth for money, stock, identity, permissions, time and approvals.
// Design notes: docs/database-schema.md. Payroll / government-ID fields are intentionally absent.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identity & access ─────────────

model User {
  id            String     @id @default(uuid()) @db.Uuid
  authUserId    String     @unique @db.Uuid // Supabase auth.users.id
  email         String     @unique
  displayName   String?
  avatarPath    String?
  /// Profile picture from the identity provider (Google), refreshed at sign-in. Display only.
  avatarUrl     String?
  status        UserStatus @default(ACTIVE)
  /// Firebase Auth uid from the old site (migration links chats, quotes and feedback to the right person).
  legacyUid     String?    @unique
  roles         UserRole[]
  customer      Customer?
  employee      Employee?
  auditLogs     AuditLog[]
  conversations Conversation[]
  wishlist      WishlistItem[]
  assistantConversations AssistantConversation[]
  contactInquiries ContactInquiry[]
  notifications Notification[]
  pushSubscriptions PushSubscription[]
  notificationPrefs NotificationPreference[]
  lastLoginAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  isSystem    Boolean          @default(false)
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  grantedBy String?  @db.Uuid
  grantedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
}

// ───────────── Customers ─────────────

model Customer {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String?     @unique @db.Uuid
  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email            String
  name             String
  phone            String?
  marketingConsent Boolean     @default(false)
  addresses        Address[]
  carts            Cart[]
  orders           Order[]
  quotations       Quotation[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@index([email])
}

model Address {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label      String?
  recipient  String
  phone      String
  line1      String
  line2      String?
  barangay   String?
  city       String
  province   String
  postalCode String?
  isDefault  Boolean  @default(false)

  @@index([customerId])
}

// ───────────── Catalog & inventory ─────────────

model Category {
  id        String     @id @default(uuid()) @db.Uuid
  slug      String     @unique
  name      String
  parentId  String?    @db.Uuid
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children  Category[] @relation("CategoryTree")
  sortOrder Int        @default(0)
  products  Product[]
}

model Product {
  id             String           @id @default(uuid()) @db.Uuid
  slug           String           @unique
  name           String
  scientificName String?
  nativeName     String?
  plantType      String?
  categoryId     String           @db.Uuid
  category       Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  status         ProductStatus    @default(DRAFT)
  isFeatured     Boolean          @default(false)
  isNew          Boolean          @default(false)
  isBestSeller   Boolean          @default(false)
  variants       ProductVariant[]
  images         ProductImage[]
  wishlistedBy   WishlistItem[]
  legacyId       String?          @unique
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([status, isFeatured])
  @@index([categoryId, status])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  HIDDEN
  ARCHIVED
}

model ProductVariant {
  id             String          @id @default(uuid()) @db.Uuid
  productId      String          @db.Uuid
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String          @unique
  name           String
  attributes     Json            @default("{}")
  price          Decimal         @db.Decimal(12, 2)
  compareAtPrice Decimal?        @db.Decimal(12, 2)
  isActive       Boolean         @default(true)
  trackInventory Boolean         @default(true)
  inventory      InventoryLevel?
  movements      StockMovement[]
  orderItems     OrderItem[]
  cartItems      CartItem[]

  @@index([productId])
}

model ProductImage {
  id        String     @id @default(uuid()) @db.Uuid
  productId String     @db.Uuid
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String     @db.Uuid
  media     MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  alt       String?
  sortOrder Int        @default(0)

  @@index([productId])
}

/// on_hand >= 0, reserved >= 0, reserved <= on_hand enforced by CHECK constraint (raw SQL in migration).
model InventoryLevel {
  variantId  String         @id @db.Uuid
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  onHand     Int            @default(0)
  reserved   Int            @default(0)
  lowStockAt Int            @default(5)
  version    Int            @default(0)
  updatedAt  DateTime       @updatedAt
}

model StockMovement {
  id        String            @id @default(uuid()) @db.Uuid
  variantId String            @db.Uuid
  variant   ProductVariant    @relation(fields: [variantId], references: [id], onDelete: Restrict)
  type      StockMovementType
  quantity  Int // signed
  reason    String?
  orderId   String?           @db.Uuid
  actorId   String?           @db.Uuid
  createdAt DateTime          @default(now())

  @@index([variantId, createdAt])
  @@index([orderId])
}

enum StockMovementType {
  RECEIVE
  ADJUST
  SALE
  RESERVE
  RELEASE
  RETURN
  DAMAGE
}

/// Delivery fee by municipality (D7). Inactive until the business sets a real fee.
model DeliveryZone {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  province  String   @default("Palawan")
  fee       Decimal? @db.Decimal(12, 2)
  isActive  Boolean  @default(false)
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ───────────── Cart, orders, payments ─────────────

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String?    @db.Uuid
  customer   Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  anonToken  String?    @unique
  status     CartStatus @default(OPEN)
  items      CartItem[]
  expiresAt  DateTime
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([customerId, status])
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @db.Uuid
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int

  @@unique([cartId, variantId])
}

model Order {
  id              String            @id @default(uuid()) @db.Uuid
  number          String            @unique
  customerId      String            @db.Uuid
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  status          OrderStatus       @default(PENDING_PAYMENT)
  fulfillment     FulfillmentStatus @default(UNFULFILLED)
  currency        String            @default("PHP")
  subtotal        Decimal           @db.Decimal(12, 2)
  deliveryFee     Decimal           @db.Decimal(12, 2)
  discount        Decimal           @default(0) @db.Decimal(12, 2)
  total           Decimal           @db.Decimal(12, 2)
  shippingAddress Json
  notes           String?
  idempotencyKey  String?           @unique
  /// Stock stays reserved for an unpaid order until this time; then the order is cancelled and stock released.
  reservationExpiresAt DateTime?
  /// sha256 of the secret in the guest's order link (signed-in customers use their account instead).
  accessKeyHash   String?
  items           OrderItem[]
  payments        Payment[]
  events          OrderEvent[]
  placedAt        DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([customerId, placedAt])
  @@index([status, placedAt])
  @@index([status, reservationExpiresAt])
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
  COMPLETED
}

enum FulfillmentStatus {
  UNFULFILLED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

model OrderItem {
  id        String         @id @default(uuid()) @db.Uuid
  orderId   String         @db.Uuid
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId String         @db.Uuid
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  sku       String
  name      String
  unitPrice Decimal        @db.Decimal(12, 2)
  quantity  Int
  lineTotal Decimal        @db.Decimal(12, 2)

  @@index([orderId])
}

model OrderEvent {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @db.Uuid
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      String
  data      Json?
  actorId   String?  @db.Uuid
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model Payment {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @db.Uuid
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  provider    String
  providerRef String
  status      PaymentStatus @default(PENDING)
  amount      Decimal       @db.Decimal(12, 2)
  currency    String
  isTest      Boolean       @default(true)
  rawLast     Json?
  refunds     Refund[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([status, createdAt])
}

enum PaymentStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Refund {
  id          String   @id @default(uuid()) @db.Uuid
  paymentId   String   @db.Uuid
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  providerRef String?  @unique
  amount      Decimal  @db.Decimal(12, 2)
  reason      String?
  status      String
  actorId     String   @db.Uuid
  createdAt   DateTime @default(now())

  @@index([paymentId])
}

/// Idempotency ledger for provider webhooks: insert first, unique violation = already processed.
model WebhookEvent {
  id          String    @id
  provider    String
  type        String
  payload     Json
  processedAt DateTime?
  error       String?
  receivedAt  DateTime  @default(now())
}

// ───────────── Quotations, messages, inquiries ─────────────

model Quotation {
  id              String                @id @default(uuid()) @db.Uuid
  number          String                @unique
  customerId      String?               @db.Uuid
  customer        Customer?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  name            String
  email           String
  phone           String
  services        String[]
  projectLocation String?
  propertyType    String?
  areaSqm         Int?
  preferredDate   DateTime?             @db.Date
  bestTimeToTalk  String?
  budgetRange     String?
  details         String
  status          QuotationStatus       @default(NEW)
  assignedToId    String?               @db.Uuid
  attachments     QuotationAttachment[]
  notes           QuotationNote[]
  legacyId        String?               @unique
  submittedAt     DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, submittedAt])
  @@index([email])
}

enum QuotationStatus {
  NEW
  CONTACTED
  SITE_VISIT
  QUOTED
  WON
  LOST
  ARCHIVED
}

model QuotationAttachment {
  id          String     @id @default(uuid()) @db.Uuid
  quotationId String     @db.Uuid
  quotation   Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  mediaId     String     @db.Uuid
  media       MediaAsset @relation(fields: [mediaId], references: [id], onDelete: Restrict)
}

model QuotationNote {
  id          String    @id @default(uuid()) @db.Uuid
  quotationId String    @db.Uuid
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  authorId    String    @db.Uuid
  body        String
  createdAt   DateTime  @default(now())
}

model Conversation {
  id             String    @id @default(uuid()) @db.Uuid
  customerUserId String    @db.Uuid
  customer       User      @relation(fields: [customerUserId], references: [id], onDelete: Cascade)
  status         String    @default("open")
  lastMessageAt  DateTime?
  unreadForStaff Int       @default(0)
  messages       Message[]
  legacyId       String?   @unique
  createdAt      DateTime  @default(now())

  @@index([lastMessageAt])
  @@index([customerUserId])
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId   String       @db.Uuid
  body           String
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model ContactInquiry {
  id        String         @id @default(uuid()) @db.Uuid
  /// The signed-in sender (messages now require an account); null for messages sent before that.
  userId    String?        @db.Uuid
  user      User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  name      String
  email     String
  phone     String?
  subject   String?
  body      String
  status    String         @default("new") // new | replied | closed
  replies   InquiryReply[]
  createdAt DateTime       @default(now())

  @@index([status, createdAt])
  @@index([userId])
}

/// A staff reply to a contact-form message, sent by email.
model InquiryReply {
  id           String         @id @default(uuid()) @db.Uuid
  inquiryId    String         @db.Uuid
  inquiry      ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  senderUserId String         @db.Uuid
  body         String
  sentAt       DateTime       @default(now())

  @@index([inquiryId, sentAt])
}

/// Small admin-editable settings (e.g. who receives notification emails). Secrets never live here.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?  @db.Uuid
  updatedAt   DateTime @updatedAt
}

// ───────────── Media metadata (bytes live in Supabase Storage) ─────────────

model MediaAsset {
  id                   String                @id @default(uuid()) @db.Uuid
  bucket               String
  path                 String
  mimeType             String
  sizeBytes            Int
  width                Int?
  height               Int?
  alt                  String?
  blurDataUrl          String?
  checksum             String?
  /// Original URL when imported from the old site (idempotent re-imports).
  sourceUrl            String?               @unique
  uploadedById         String?               @db.Uuid
  refCount             Int                   @default(0)
  createdAt            DateTime              @default(now())
  productImages        ProductImage[]
  quotationAttachments QuotationAttachment[]

  @@unique([bucket, path])
  @@index([refCount, createdAt])
}

// ───────────── Workforce: attendance only (no payroll) ─────────────

model Department {
  id        String     @id @default(uuid()) @db.Uuid
  name      String     @unique
  employees Employee[]
}

model Employee {
  id                  String               @id @default(uuid()) @db.Uuid
  userId              String?              @unique @db.Uuid
  user                User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  employeeNo          String               @unique
  firstName           String
  lastName            String
  email               String?
  mobile              String?
  position            String?
  departmentId        String?              @db.Uuid
  department          Department?          @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  employmentStatus    EmploymentStatus     @default(ACTIVE)
  hiredOn             DateTime?            @db.Date
  photoMediaId        String?              @db.Uuid
  managerId           String?              @db.Uuid
  manager             Employee?            @relation("Reports", fields: [managerId], references: [id], onDelete: SetNull)
  reports             Employee[]           @relation("Reports")
  scheduleAssignments ScheduleAssignment[]
  attendance          AttendanceRecord[]
  leaveRequests       LeaveRequest[]
  leaveBalances       LeaveBalance[]
  legacyId            String?              @unique
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
}

enum EmploymentStatus {
  ACTIVE
  ON_LEAVE
  PROBATION
  RESIGNED
  TERMINATED
}

model WorkSchedule {
  id           String               @id @default(uuid()) @db.Uuid
  name         String
  timezone     String               @default("Asia/Manila")
  isFlexible   Boolean              @default(false)
  graceMinutes Int                  @default(10)
  shifts       ScheduleShift[]
  assignments  ScheduleAssignment[]
}

/// One row per segment: supports split shifts (morning + afternoon) and overnight (endTime < startTime).
model ScheduleShift {
  id           String       @id @default(uuid()) @db.Uuid
  scheduleId   String       @db.Uuid
  schedule     WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  weekday      Int // 0 = Sunday … 6 = Saturday
  startTime    String // "HH:mm"
  endTime      String
  breakMinutes Int          @default(0)

  @@index([scheduleId, weekday])
}

model ScheduleAssignment {
  id            String       @id @default(uuid()) @db.Uuid
  employeeId    String       @db.Uuid
  employee      Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  scheduleId    String       @db.Uuid
  schedule      WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Restrict)
  effectiveFrom DateTime     @db.Date
  effectiveTo   DateTime?    @db.Date

  @@index([employeeId, effectiveFrom])
}

model AttendanceRecord {
  id               String                 @id @default(uuid()) @db.Uuid
  employeeId       String                 @db.Uuid
  employee         Employee               @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workDate         DateTime               @db.Date // Asia/Manila business date
  status           AttendanceStatus       @default(OPEN)
  lateMinutes      Int                    @default(0)
  undertimeMinutes Int                    @default(0)
  overtimeMinutes  Int                    @default(0) // recorded only, never compensated here
  workedMinutes    Int                    @default(0)
  approvedById     String?                @db.Uuid
  approvedAt       DateTime?
  punches          TimePunch[]
  corrections      AttendanceCorrection[]

  @@unique([employeeId, workDate])
  @@index([workDate, status])
}

enum AttendanceStatus {
  OPEN
  PRESENT
  LATE
  ABSENT
  ON_LEAVE
  HOLIDAY
  INCOMPLETE
  APPROVED
}

model TimePunch {
  id           String           @id @default(uuid()) @db.Uuid
  recordId     String           @db.Uuid
  record       AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  type         PunchType
  at           DateTime
  source       String // web | kiosk | admin_correction | import
  photoMediaId String?          @db.Uuid // only when photo verification is enabled and consented
  lat          Float?
  lng          Float?
  ip           String?

  @@index([recordId, at])
}

enum PunchType {
  IN
  OUT
}

model AttendanceCorrection {
  id            String           @id @default(uuid()) @db.Uuid
  recordId      String           @db.Uuid
  record        AttendanceRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  requestedById String           @db.Uuid
  reason        String
  proposed      Json
  status        ApprovalStatus   @default(PENDING)
  decidedById   String?          @db.Uuid
  decidedAt     DateTime?
  createdAt     DateTime         @default(now())

  @@index([status])
}

model LeaveType {
  id                 String         @id @default(uuid()) @db.Uuid
  key                String         @unique
  name               String
  defaultDaysPerYear Decimal        @db.Decimal(5, 2)
  requiresAttachment Boolean        @default(false)
  requests           LeaveRequest[]
  balances           LeaveBalance[]
}

model LeaveBalance {
  id          String    @id @default(uuid()) @db.Uuid
  employeeId  String    @db.Uuid
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String    @db.Uuid
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  year        Int
  allotted    Decimal   @db.Decimal(5, 2)
  used        Decimal   @default(0) @db.Decimal(5, 2)

  @@unique([employeeId, leaveTypeId, year])
}

model LeaveRequest {
  id                String         @id @default(uuid()) @db.Uuid
  employeeId        String         @db.Uuid
  employee          Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  leaveTypeId       String         @db.Uuid
  leaveType         LeaveType      @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  startDate         DateTime       @db.Date
  endDate           DateTime       @db.Date
  halfDay           Boolean        @default(false)
  days              Decimal        @db.Decimal(5, 2)
  reason            String?
  attachmentMediaId String?        @db.Uuid
  status            ApprovalStatus @default(PENDING)
  decidedById       String?        @db.Uuid
  decidedAt         DateTime?
  decisionNote      String?
  legacyId          String?        @unique
  createdAt         DateTime       @default(now())

  @@index([employeeId, startDate])
  @@index([status])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Holiday {
  id   String   @id @default(uuid()) @db.Uuid
  date DateTime @unique @db.Date
  name String
  type String // regular | special_non_working | special_working
}

model Announcement {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  body        String
  priority    String    @default("normal")
  expiresAt   DateTime?
  createdById String    @db.Uuid
  legacyId    String?   @unique
  createdAt   DateTime  @default(now())
}

/// A product a customer saved for later.
model WishlistItem {
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String   @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

/// A chat with the AI assistant. Belongs to one signed-in user; only they (and staff with assistant.read) can read it.
model AssistantConversation {
  id        String             @id @default(uuid()) @db.Uuid
  userId    String             @db.Uuid
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String             @default("New conversation")
  /// open | escalated (handed to a person through Messages)
  status    String             @default("open")
  messages  AssistantMessage[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([userId, updatedAt])
  @@index([updatedAt])
}

model AssistantMessage {
  id             String                @id @default(uuid()) @db.Uuid
  conversationId String                @db.Uuid
  conversation   AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant
  role           String
  content        String
  provider       String?
  model          String?
  inputTokens    Int?
  outputTokens   Int?
  /// Set when the provider failed; the user saw a friendly message instead.
  error          String?
  createdAt      DateTime              @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

// ───────────── Notifications ─────────────
// In-app inbox + Web Push. Fan-out and delivery design: docs/notifications.md.

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  GONE // the push service said the subscription is expired or revoked; the subscription is deleted
}

model Notification {
  id          String               @id @default(uuid()) @db.Uuid
  recipientId String               @db.Uuid
  recipient   User                 @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  /// Which frontend shows it: "web" (customer site) or "admin" (staff console). A staff member who also shops sees each in its own app.
  app         String
  type        String // e.g. "order.paid"; see apps/api/src/modules/notifications/events.ts
  category    String // preference bucket: orders, quotes, messages, stock, hr, account, system
  title       String
  message     String
  /// { href: "/orders/GS-…", … }: deep link (relative to the app) plus whatever the type needs.
  payload     Json?
  priority    NotificationPriority @default(NORMAL)
  /// Idempotency: the same event for the same recipient is stored once.
  dedupeKey   String?
  readAt      DateTime?
  createdAt   DateTime             @default(now())
  expiresAt   DateTime?
  deliveries  NotificationDelivery[]

  @@unique([recipientId, dedupeKey])
  @@index([recipientId, app, createdAt(sort: Desc)])
  @@index([recipientId, app, readAt])
  @@index([expiresAt])
}

model PushSubscription {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  app          String // "web" | "admin": each origin has its own service worker
  /// Stable id the browser generates once, so re-subscribing replaces the row instead of piling up.
  deviceId     String
  platform     String   @default("web")
  endpoint     String   @unique
  p256dh       String
  auth         String
  userAgent    String?
  failureCount Int      @default(0)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  deliveries   NotificationDelivery[]

  @@unique([userId, app, deviceId])
  @@index([userId, app])
}

model NotificationPreference {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String  @db.Uuid
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Granular by category, not type: the set of types grows, what people want to mute does not.
  category  String
  inApp     Boolean @default(true)
  push      Boolean @default(true)
  sound     Boolean @default(true)

  @@unique([userId, category])
}

/// One row per push attempt target; doubles as the durable queue (worker claims PENDING rows whose nextAttemptAt has passed).
model NotificationDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  notificationId String             @db.Uuid
  notification   Notification       @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  subscriptionId String?            @db.Uuid // kept (null) after the subscription is removed, so the failure history survives
  subscription   PushSubscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  channel        String             @default("push")
  status         DeliveryStatus     @default(PENDING)
  attempts       Int                @default(0)
  nextAttemptAt  DateTime           @default(now())
  deliveredAt    DateTime?
  failureReason  String?
  createdAt      DateTime           @default(now())

  @@unique([notificationId, subscriptionId]) // never push the same notification to the same device twice
  @@index([status, nextAttemptAt])
}
