# Production values for docker/compose.prod.yml. Copy OUTSIDE the repository, fill in, and pass with --env-file
# (or set them in the platform's secret store). Generate each password/secret separately, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Rotation: change the value here and in the service it belongs to, then restart the dependent containers
# (docs/security/incident-response.md, "Rotating credentials").
REGISTRY=
TAG=
WEB_URL=https://greenscapelandscapingph.com
ADMIN_URL=https://admin.greenscapelandscapingph.com
API_PUBLIC_URL=https://api.greenscapelandscapingph.com
POSTGRES_OWNER_PASSWORD=
POSTGRES_MIGRATE_PASSWORD=
POSTGRES_APP_PASSWORD=
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
REDIS_APP_PASSWORD=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
INTERNAL_API_KEY=
REVALIDATE_SECRET=
PREVIEW_SECRET=
# Test mode only until the owner approves live payments (PAYMENTS_LIVE_APPROVED stays false here).
PAYMENT_PROVIDER=stripe_test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMTP_URL=
SENTRY_DSN=
# AI assistant (API only). Leave empty to keep the assistant off; see docs/auth/ai-assistant.md.
ANTHROPIC_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
TRUSTED_PROXY_HOPS=1
